@url=http://localhost:3000

### Ver todos los datos alumnos existentes.
GET {{url}}/alumnos

### Detalle por alumno.
GET {{url}}/alumnos/3

### Agregar un nuevo alumno.
POST {{url}}/alumnos
Content-Type: application/json

{
    "nombre": "Daniel",
    "materiaId": 2, 
    "nota_1": 8,
    "nota_2": 3,
    "nota_3": 8
}

### Cambiar datos de un alumno. 
PUT {{url}}/alumnos/2
Content-Type: application/json

{
    "nombre": "Martin",
    "materiaId": 3, 
    "nota_1": 7,
    "nota_2": 7,
    "nota_3": 7
}

### Eliminar alumno.
DELETE {{url}}/alumnos/5